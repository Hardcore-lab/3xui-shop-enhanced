# Bot
BOT_TOKEN=
BOT_DEV_ID=123456789
BOT_SUPPORT_ID=123456789
# Public domain for connection and payment links (required in production). No trailing slash, e.g. bot.example.com
BOT_DOMAIN=bot.example.com

# 3xUI panel
XUI_USERNAME=
XUI_PASSWORD=

# Payment: Telegram Stars (default on) and Heleket
SHOP_PAYMENT_STARS_ENABLED=true
SHOP_PAYMENT_HELEKET_ENABLED=false
# If Heleket enabled:
# HELEKET_API_KEY=your_key
# HELEKET_MERCHANT_ID=your_merchant_id
# HELEKET_WEBHOOK_IPS=31.133.220.8

# Database (SQLite by default: leave DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD empty)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=vpn_bot
# DB_PASSWORD=your_password
# DB_NAME=vpn_shop

# Redis (defaults used if not set)
# REDIS_HOST=3xui-shop-redis
# REDIS_PORT=6379

# Optional
# LETSENCRYPT_EMAIL=example@email.com
